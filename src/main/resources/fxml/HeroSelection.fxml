                  <Button mnemonicParsing="false" onAction="#onChooseRobin" text="Scegli Robin Hood" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" layoutX="196.0" layoutY="10.0" prefHeight="200.0" prefWidth="330.0" spacing="12.0" style="-fx-border-color: #888; -fx-border-radius: 6; -fx-background-color: #f5f1e8; -fx-background-radius: 6;">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
               <children>
                  <ImageView fitHeight="168.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" smooth="false">
